import duckdb

# Connect to the database (read-only is fine for feature engineering)
con = duckdb.connect('f1.duckdb', read_only=True)

# Load the driver_season table into a pandas DataFrame
driver_season_df = con.execute("SELECT * FROM driver_season").df()

# Optional: quickly inspect
print(driver_season_df.head())

# Close the connection when done
con.close()




