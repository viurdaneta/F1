#Create columns for the modeling table
con = duckdb.connect("f1.duckdb")

con.execute("ALTER TABLE driver_season ADD COLUMN total_points DOUBLE;")

con.execute("ALTER TABLE driver_season ADD COLUMN races_entered BIGINT; ")

con.execute("ALTER TABLE driver_season ADD COLUMN dnfs BIGINT; ")

con.execute("ALTER TABLE driver_season ADD COLUMN avg_grid DOUBLE; ")

con.execute("ALTER TABLE driver_season ADD COLUMN avg_finish DOUBLE; ")

con.execute("ALTER TABLE driver_season ADD COLUMN completed_races BIGINT; ")

con.close()





con = duckdb.connect("f1.duckdb")

con.execute(
"UPDATE driver_season "
"SET total_points = ( "
"    SELECT SUM(points) "
"    FROM results_drivers_races_circuits r "
"    WHERE r.driverId = driver_season.driverId "
"      AND r.year = driver_season.year "
"      AND points IS NOT NULL "
") "
"WHERE year >= 2014 "
)

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
    "UPDATE driver_season ds "
    "SET dnfs = agg.dnfs "
    "FROM ( "
    "    SELECT driverId, year, "
    "           SUM(CASE "
    "               WHEN position IS NULL THEN 1 "
    "               ELSE 0 "
    "           END) AS dnfs "
    "    FROM results_drivers_races_circuits "
    "    WHERE year >= 2014 "
    "    GROUP BY driverId, year "
    ") agg "
    "WHERE ds.driverId = agg.driverId "
    "AND ds.year = agg.year "
)

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
    "UPDATE driver_season ds "
    "SET avg_grid = agg.avg_grid "
    "FROM ( "
    "    SELECT driverId, year, AVG(grid) AS avg_grid "
    "    FROM results_drivers_races_circuits "
    "    WHERE year >= 2014 "
    "    GROUP BY driverId, year "
    ") agg "
    "WHERE ds.driverId = agg.driverId "
    "AND ds.year = agg.year "
)

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
"UPDATE driver_season ds "
"SET avg_finish = agg.avg_finish_position "
"FROM ( "
"    SELECT driverId, year, "
"           AVG(position) AS avg_finish_position "
"    FROM results_drivers_races_circuits "
"    WHERE position IS NOT NULL "
"    GROUP BY driverId, year "
") agg "
"WHERE ds.driverId = agg.driverId "
"AND ds.year = agg.year "
) 

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
"UPDATE driver_season ds "
"SET completed_races = agg.completed_races "
"FROM ( "
"    SELECT driverId, year, "
"           SUM(CASE "
"               WHEN milliseconds IS NOT NULL "
"               THEN 1 ELSE 0 "
"           END) AS completed_races "
"    FROM results_drivers_races_circuits "
"    WHERE year >= 2014 "
"    GROUP BY driverId, year "
") agg "
"WHERE ds.driverId = agg.driverId "
"AND ds.year = agg.year "
)

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
"SELECT driverId, year, COUNT(*) "
"FROM driver_season "
"GROUP BY driverId, year "
"HAVING COUNT(*) > 1 "
).df()


con.execute(
"SELECT "
"COUNT(*) FILTER (WHERE total_points IS NULL) AS null_points, "
"COUNT(*) FILTER (WHERE races_entered IS NULL) AS null_races, "
"COUNT(*) FILTER (WHERE dnfs IS NULL) AS null_dnfs "
"FROM driver_season "
).df()


con.close()


con = duckdb.connect("f1.duckdb")

con.execute("ALTER TABLE driver_season ADD COLUMN ref VARCHAR; ")

con.close()


con = duckdb.connect("f1.duckdb")

con.execute(
"UPDATE driver_season ds "
"SET ref = agg.driverRef "
"FROM ( "
"    SELECT driverId, year, "
"           MIN(driverRef) AS driverRef "
"    FROM results_drivers_races_circuits "
"    GROUP BY driverId, year "
") agg "
"WHERE ds.driverId = agg.driverId "
"AND ds.year = agg.year "
)
con.close()


con = duckdb.connect("f1.duckdb")
con.execute("ALTER TABLE driver_season ADD COLUMN constructor VARCHAR; ")
con.close()


con = duckdb.connect("f1.duckdb")
con.execute(
"UPDATE driver_season ds "
"SET constructor = agg.constructorId "
"FROM ( "
"    SELECT driverId, year, "
"           FIRST_VALUE(constructorId) OVER (PARTITION BY driverId, year "
"                                            ORDER BY COUNT(*) DESC) AS constructorId "
"    FROM results_drivers_races_circuits "
"    WHERE year >= 2014 "
"    GROUP BY driverId, year, constructorId "
") agg "
"WHERE ds.driverId = agg.driverId "
"AND ds.year = agg.year;  "
)
con.close()


